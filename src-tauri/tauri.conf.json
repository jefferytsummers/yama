{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yama",
  "version": "0.1.0",
  "identifier": "com.yama.app",
  "build": {
    "beforeBuildCommand": "cd web && npm run build",
    "beforeDevCommand": "cd web && npm run dev",
    "frontendDist": "../web/build",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Yama",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": null,
      "frameworks": [],
      "signingIdentity": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
